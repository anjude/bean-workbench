<mxfile host="app.diagrams.net" modified="2026-11-16T00:00:00.000Z" agent="Codex" version="32.6.10" type="device"><diagram id="rope-vortex" name="赛道绳阵机制示意"><mxGraphModel dx="1100" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="760" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="大鹅冲刺｜鹅到队尾拉绳，对方进漩涡，我方得分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A13A;fontSize=22;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="45" y="20" width="1010" height="58" as="geometry" /></mxCell><mxCell id="s1" value="一条赛道的绳阵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0EBFA;strokeColor=#8AACC9;fontSize=18;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="45" y="100" width="1010" height="45" as="geometry" /></mxCell><mxCell id="track" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9F5;strokeColor=#AAB8C6;fontSize=18;" parent="1" vertex="1"><mxGeometry x="65" y="165" width="970" height="225" as="geometry" /></mxCell><mxCell id="rope" value="∞ 无限长绳&#10;绳上有标记" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A13A;fontSize=18;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="410" y="255" width="220" height="85" as="geometry" /></mxCell><mxCell id="baseA" value="我方基地" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0EBFA;strokeColor=#6E9BC7;fontSize=18;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="85" y="245" width="135" height="75" as="geometry" /></mxCell><mxCell id="teamA" value="我方鹅队&#10;新鹅到队尾拉绳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6E9BC7;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="245" y="225" width="145" height="115" as="geometry" /></mxCell><mxCell id="vortex" value="中央&#10;漩涡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EADCF8;strokeColor=#9B7AB8;fontSize=18;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="650" y="235" width="115" height="95" as="geometry" /></mxCell><mxCell id="teamB" value="对方鹅队&#10;前排鹅靠近漩涡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97972;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="785" y="225" width="145" height="115" as="geometry" /></mxCell><mxCell id="baseB" value="对方基地" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAE3E1;strokeColor=#D97972;fontSize=15;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="945" y="245" width="80" height="75" as="geometry" /></mxCell><mxCell id="ropeA" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#536E8A;endArrow=block;fontSize=13;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="baseA" target="teamA"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ropeB" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#536E8A;endArrow=block;fontSize=13;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="teamA" target="rope"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ropeC" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#536E8A;endArrow=block;fontSize=13;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="rope" target="vortex"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ropeD" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#536E8A;endArrow=block;fontSize=13;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="vortex" target="teamB"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ropeE" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#536E8A;endArrow=block;fontSize=13;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="teamB" target="baseB"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sequence" value="① 鹅到时间自动提供　② 玩家点选赛道　③ 新鹅跑到本队末尾加入拉绳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8AACC9;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="115" y="405" width="870" height="48" as="geometry" /></mxCell><mxCell id="equal" value="双方总力量相同：绳上标记停住，双方僵持" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A13A;fontSize=17;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="115" y="465" width="870" height="48" as="geometry" /></mxCell><mxCell id="advantage" value="我方力量较大：标记向我方基地移动，对方前排鹅被拉向漩涡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF0E5;strokeColor=#7AB595;fontSize=17;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="115" y="525" width="870" height="48" as="geometry" /></mxCell><mxCell id="score" value="对方鹅被漩涡吸走 → 我方得分增加一次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF4;strokeColor=#8AACC9;fontSize=18;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="115" y="585" width="870" height="48" as="geometry" /></mxCell><mxCell id="small" value="小鹅被吸走&#10;我方加分多" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A13A;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="180" y="655" width="260" height="68" as="geometry" /></mxCell><mxCell id="hidden" value="界面只显示双方总分&#10;不显示力量、速度和单鹅得分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB8C6;fontSize=14;" parent="1" vertex="1"><mxGeometry x="420" y="655" width="260" height="68" as="geometry" /></mxCell><mxCell id="large" value="大鹅被吸走&#10;我方加分少" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAE3E1;strokeColor=#D97972;fontSize=16;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="660" y="655" width="260" height="68" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>