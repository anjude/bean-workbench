1"><mxGeometry x="690" y="220" width="195" height="100" as="geometry" /></mxCell><mxCell id="baseB" value="红方基线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAE3E1;strokeColor=#D97972;fontSize=17;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="875" y="235" width="115" height="70" as="geometry" /></mxCell><mxCell id="moveA" value="蓝方合力推向右" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#536E8A;endArrow=block;fontSize=14;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="blue1" target="front"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="moveB" value="红方合力推向左" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#536E8A;endArrow=block;fontSize=14;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="red1" target="front"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="equal" value="总力量相同：交锋线停住，双方僵持" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A13A;fontSize=17;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="210" y="410" width="680" height="46" as="geometry" /></mxCell><mxCell id="greater" value="一方总力量更大：交锋线向对方基线推进" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF0E5;strokeColor=#7AB595;fontSize=17;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="210" y="466" width="680" height="46" as="geometry" /></mxCell><mxCell id="h2" value="② 一只鹅越过对方基线，就扣对方一次分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEF4;strokeColor=#8AACC9;fontSize=19;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="55" y="535" width="990" height="48" as="geometry" /></mxCell><mxCell id="goose" value="蓝方一只鹅&#10;冲过红方基线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6E9BC7;fontSize=17;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="105" y="605" width="210" height="74" as="geometry" /></mxCell><mxCell id="cross" value="红方基线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAE3E1;strokeColor=#D97972;fontSize=17;fontStyle=1;" parent="1" vertex="1"><m